node_modules/
dist/
/coverage/

# Local proof output is intentionally retained only as bounded evidence files.
.pr-proof/*
!.pr-proof/
!.pr-proof/baseline.json
!.pr-proof/history.jsonl

# Factory-as-code is source. Only the documented source tree is re-included;
# generated runs, receipts, caches, artifacts, and imported worktrees remain
# ignored unless a reviewed rule explicitly promotes them to source.
.tinkerbot/*
!.tinkerbot/
!.tinkerbot/config.yml
!.tinkerbot/config.yaml
!.tinkerbot/config.json
!.tinkerbot/tinkerbot.yml
!.tinkerbot/tinkerbot.yaml
!.tinkerbot/tinkerbot.json
!.tinkerbot/factory.yml
!.tinkerbot/factory.yaml
!.tinkerbot/autonomy.yaml
!.tinkerbot/evolution.yaml
!.tinkerbot/product.yaml
!.tinkerbot/agents/
!.tinkerbot/agents/**
!.tinkerbot/automations/
!.tinkerbot/automations/**
!.tinkerbot/runners/
!.tinkerbot/runners/**
!.tinkerbot/lines/
!.tinkerbot/lines/**
!.tinkerbot/skills/
!.tinkerbot/skills/**
!.tinkerbot/evals/
!.tinkerbot/evals/**
!.tinkerbot/change-contract.yml

# Never import managed worktree state or local execution output into the
# source tree by accident.
.tinkerbot/cache/
.tinkerbot/runs/
.tinkerbot/receipts/
.tinkerbot/artifacts/
.tinkerbot/worktrees/
.worktrees/

.DS_Store
*.log
*.tsbuildinfo
/test-results/
/vitest-results.json
/playwright-report/
/blob-report/
**/.dev.vars
**/.env.*
!.env.example
!**/.env.example

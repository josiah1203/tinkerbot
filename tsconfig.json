{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["packages/**/*.ts", "action/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "fixtures/**/node_modules", "packages/**/*.test.ts", "tests/e2e"]
}

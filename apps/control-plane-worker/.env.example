# Local development only. Copy to .dev.vars and replace placeholders locally.
# Never commit .dev.vars or real values.
WORKOS_CLIENT_ID=client_placeholder
WORKOS_API_KEY=sk_test_placeholder
WORKOS_WEBHOOK_SECRET=whsec_workos_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
SESSION_ENCRYPTION_KEY=replace_with_a_long_random_value
GITHUB_WEBHOOK_SECRET=github_webhook_secret_placeholder
GITLAB_WEBHOOK_SECRET=gitlab_webhook_secret_placeholder
EVIDENCE_EXPORT_ENDPOINT=
EVIDENCE_EXPORT_TOKEN=
GITHUB_APP_ID=1
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace\n-----END PRIVATE KEY-----"
CONTROL_PLANE_URL=https://control.tinkerbot.dev
WORKOS_REDIRECT_URI=https://control.tinkerbot.dev/auth/workos/callback
AI_GATEWAY_ID=tinkerbot-factory
CLOUDFLARE_ACCOUNT_ID=account_placeholder
STRIPE_PLANS_JSON=[]
# Integration webhooks are disabled in production until each provider has a signing secret and tenant binding.
SLACK_WEBHOOK_SECRET=
LINEAR_WEBHOOK_SECRET=
JIRA_WEBHOOK_SECRET=
INCIDENT_WEBHOOK_SECRET=
SUPPORT_WEBHOOK_SECRET=
INTEGRATION_ORGANIZATION_ID=
SELF_HOSTED_WORK_SECRET=replace_with_a_distinct_hmac_secret_if_self_hosted_workers_are_enabled
# Optional alternative to the Cloudflare Queue producer for workers outside this account. HTTPS only in non-local environments.
SELF_HOSTED_WORK_ENDPOINT=
STRIPE_WEBHOOK_URL=https://worker.example/billing/webhook
WORKOS_WEBHOOK_URL=https://worker.example/integrations/workos/webhook
WORKOS_EVENTS_SYNC_ENABLED=false
# Staging bootstrap choice: replay the previous seven days, then advance by D1 cursor.
# WORKOS_EVENTS_RANGE_START=2026-08-11T00:00:00.000Z
